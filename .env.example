# Valores fictícios somente para desenvolvimento local.
# O Compose lê este arquivo apenas depois de copiá-lo para .env.
API_PORT=3000
DB_PORT=5432
APP_ENV=local
SERVICE_NAME=pix-antifraud
INTERNAL_TOKEN=default_token
# O padrão é relativo ao pacote e funciona no host e no container.
# Só defina um caminho alternativo que exista no ambiente de execução.
# PIX_POLICY_FILE=/caminho/para/policies.json
# Opcional: JSON por tenant com credencial e ISPB de origem. A política precisa
# conter o mesmo tenant. Sem configuração: demo / INTERNAL_TOKEN / 00000000 (fictício).
# PIX_TENANTS={"demo":{"token":"default_token","participant":"00000000"}}
# Dataset normalizado opcional, montado somente para leitura no container.
# Ausência de dataset produz not_covered, nunca reputação limpa.
# PIX_FIXTURE_FILE=/fixtures/pix.json

# Para comandos Python executados NO HOST. Dentro do Compose o host é db.
# Os testes não usam este banco: execute compose.test.yml, conforme README.
DATABASE_URL=postgresql+psycopg2://bootcamp:bootcamp@127.0.0.1:5432/bootcamp
