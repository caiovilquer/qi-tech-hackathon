{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PostPixTransaction",
  "description": "Contrato estrutural do POST /pix/transaction. Datas, DV, finitude, id imprimivel e canal apos strip sao conferidos por contrato_pix.normalize_payload.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": {"enum": [".", ".."]},
      "pattern": "^[^/?#\\u0000-\\u001F\\u007F-\\u009F]+$(?![\\s\\S])"
    },
    "amount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000000
    },
    "transaction_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?([Zz]|[+-][0-9]{2}:[0-9]{2})$(?![\\s\\S])"
    },
    "source_account": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string",
          "pattern": "^[0-9]{1,4}$(?![\\s\\S])"
        },
        "account_number": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$(?![\\s\\S])"
        },
        "opening_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?([Zz]|[+-][0-9]{2}:[0-9]{2})$(?![\\s\\S])"
        },
        "owner": {
          "type": "object",
          "properties": {
            "document_number": {
              "type": "string",
              "pattern": "^([0-9]{11}|[0-9]{3}\\.[0-9]{3}\\.[0-9]{3}-[0-9]{2}|[0-9A-Za-z]{12}[0-9]{2}|[0-9A-Za-z]{2}\\.[0-9A-Za-z]{3}\\.[0-9A-Za-z]{3}/[0-9A-Za-z]{4}-[0-9]{2})$(?![\\s\\S])"
            }
          },
          "required": [
            "document_number"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "branch",
        "account_number",
        "opening_date",
        "owner"
      ],
      "additionalProperties": false
    },
    "destination_account": {
      "type": "object",
      "properties": {
        "participant": {
          "type": "string",
          "pattern": "^[0-9A-Za-z]{8}$(?![\\s\\S])"
        },
        "branch": {
          "type": "string",
          "pattern": "^[0-9]{1,4}$(?![\\s\\S])"
        },
        "account_number": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$(?![\\s\\S])"
        },
        "opening_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?([Zz]|[+-][0-9]{2}:[0-9]{2})$(?![\\s\\S])"
        },
        "owner": {
          "type": "object",
          "properties": {
            "document_number": {
              "type": "string",
              "pattern": "^([0-9]{11}|[0-9]{3}\\.[0-9]{3}\\.[0-9]{3}-[0-9]{2}|[0-9A-Za-z]{12}[0-9]{2}|[0-9A-Za-z]{2}\\.[0-9A-Za-z]{3}\\.[0-9A-Za-z]{3}/[0-9A-Za-z]{4}-[0-9]{2})$(?![\\s\\S])"
            }
          },
          "required": [
            "document_number"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "participant",
        "branch",
        "account_number",
        "opening_date",
        "owner"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "device_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "channel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "ip": {
          "type": "string",
          "description": "Obrigatorio como texto. IP invalido nao reprova o schema: gera IP_INVALID e ip normalizado null; o texto original continua compondo o hash."
        },
        "geolocation": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "required": [
            "latitude",
            "longitude"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "device_id",
        "channel",
        "ip"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "amount",
    "transaction_date",
    "source_account",
    "destination_account",
    "source"
  ],
  "additionalProperties": false
}
